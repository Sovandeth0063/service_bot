# Copy to .env and fill in. Never commit .env.
BOT_TOKEN=123456:replace-me
# Optional, older way: super-admins by numeric Telegram id (from @userinfobot). Prefer ADMIN_USERNAMES.
ADMIN_USER_IDS=
# Super-admins by Telegram username (comma-separated, no @): post to any sangkat, manage clerks
ADMIN_USERNAMES=your_username
DEMO_COMMUNE_CODE=120101
DB_PATH=data/sangkat.db
# true = every contact card shows the "demo data" notice
DEMO_MODE=true
# Optional: Claude API key. Turns on the AI news writer (clerk sends messy notes,
# the bot makes text + flyer + voice). Leave empty for manual posting only.
ANTHROPIC_API_KEY=
